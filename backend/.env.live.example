# Copy to backend/.env.live (git-ignored) and fill in. Read only by
# `pnpm test:live` (tests/live/). Never commit the real file.
#
# The backend to test. Allowed: a local backend (localhost / 127.0.0.1) that
# runs against the TestCRM database, or a hosted URL ending in /TestCRM.
# The suite also proves the database by signing in as am_amit and finding
# every AM- seed tag (script 136, TestCRM only); otherwise it refuses.
LIVE_BASE_URL=http://localhost:5001
# The password of the RefUser 136 was applied with (every am_ persona has it).
LIVE_PASSWORD=
