# Copy to backend/.env.live (git-ignored) and fill in. Read only by
# `pnpm test:live` (tests/live/). Never commit the real file.
#
# The backend to test. Allowed: a local backend (localhost / 127.0.0.1) that
# runs against the TestCRM database, or exactly https://shadowcodes.in/TestCRM.
# Anything else is refused before a request is made. The suite then proves the
# database by signing in as am_amit and finding every AM- seed tag (script
# 136, TestCRM only); every persona call waits for that proof.
LIVE_BASE_URL=http://localhost:5001
# The test-only password every am_ persona has (never a real person's).
LIVE_PASSWORD=
